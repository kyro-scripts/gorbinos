; Engine configuration file.
; Gorbino's Quest - Godot 4.5 project

config_version=5

[application]

config/name="Gorbino's Quest"
config/description="A first-person shooter. Gorbinos. Snirbies. Shoot them."
config/version="1.9.6"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.04, 0.0, 0.05, 1)
boot_splash/show_image=false
run/max_fps=0
run/flush_stdout_on_print=true

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Audio="*res://scripts/autoload/audio.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="barrel"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_transforms_to_pixel=true

[shader_globals]

level_light={
"type": "sampler2D",
"value": ""
}
level_info={
"type": "vec4",
"value": Vector4(2, 64, 64, 0)
}
fog_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
fog_params={
"type": "vec4",
"value": Vector4(20, 80, 1.5, 0.03)
}
dl_p0={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0.001)
}
dl_p1={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0.001)
}
dl_p2={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0.001)
}
dl_p3={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0.001)
}
dl_p4={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0.001)
}
dl_p5={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0.001)
}
dl_c0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
dl_c1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
